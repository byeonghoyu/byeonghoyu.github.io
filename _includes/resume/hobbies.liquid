{%- assign hobbies_data = data[1] -%}
{%- if hobbies_data -%}
<div class="list-groups">
  {%- for hobby in hobbies_data -%}
    <div class="list-group col-md-6">
      <table class="table-cv list-group-table">
        <tbody>
          <tr>
            <td class="list-group-category-icon"></td>
            <td colspan="2" class="list-group-category">{{ hobby.name }}</td>
          </tr>
          {%- for keyword in hobby.keywords -%}
            <tr>
              <td></td>
              <td class="list-group-name">
                <span>{{ keyword }}</span>
              </td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  {%- endfor -%}
</div>
{%- endif -%}
