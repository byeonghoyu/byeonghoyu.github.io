{% assign skip_basics = 'image,profiles,location' | split: ',' %}
{% assign profile_image = data[1].image | default: '' %}
{% assign has_profile_image = profile_image != '' %}

<div class="cv-basics">
  {% if has_profile_image %}
    {% assign profile_image_url = profile_image %}
    {% unless profile_image_url contains '://' %}
      {% assign profile_image_url = profile_image_url | relative_url %}
    {% endunless %}
    <div class="cv-basics__photo">
      <img src="{{ profile_image_url }}" alt="{{ data[1].name | default: 'Profile photo' }}" loading="lazy" />
    </div>
  {% endif %}

  <div class="cv-basics__details">
    <table class="table table-cv table-sm table-borderless table-responsive table-cv-map">
      {% for content in data[1] %}
        {%
          if (content[1] == "") or (skip_basics contains
          content[0])
        %}
          {% continue %}
        {% endif %}

        <tr>
          <td class="p-1 pr-2 font-weight-bold">
            <b>{{ content[0] | capitalize }}</b>
          </td>
          <td class="p-1 pl-2 font-weight-light text">
            {% if content[0] == 'url' or content[0] == 'linkedin' %}
              {% assign link_label = content[1] %}
              {% if content[0] == 'url' %}
                {% assign link_label = link_label
                  | replace: 'https://', ''
                  | replace: 'http://', ''
                  | replace: 'www.', '' %}
              {% elsif content[0] == 'linkedin' %}
                {% assign link_label = 'LinkedIn' %}
              {% endif %}
              <a href="{{ content[1] }}" target="_blank" rel="noopener noreferrer">{{ link_label }}</a>
            {% elsif content[0] == 'email' %}
              <a href="mailto:{{ content[1] }}" target="_blank">{{ content[1] }}</a>
            {% elsif content[0] == 'phone' %}
              <a href="tel:{{ content[1] }}">{{ content[1] }}</a>
            {% else %}
              {{ content[1] }}
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </table>
  </div>
</div>
